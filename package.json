{
  "name": "opencode-handy-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Local voice dictation for OpenCode Desktop through Handy (GigaAM, Parakeet, Whisper).",
  "keywords": [
    "dictation",
    "gigaam",
    "handy",
    "opencode",
    "opencode-plugin",
    "speech-to-text",
    "whisper"
  ],
  "homepage": "https://github.com/ivalushin0/opencode-handy-voice#readme",
  "bugs": {
    "url": "https://github.com/ivalushin0/opencode-handy-voice/issues"
  },
  "license": "MIT",
  "author": "ivalushin0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivalushin0/opencode-handy-voice.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "oxlint --ignore-pattern dist .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "check": "npm run lint && npm run fmt && npm run typecheck",
    "bundle": "vite build"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.2",
    "@types/node": "^24.19.2",
    "effect": "4.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.65.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  }
}
